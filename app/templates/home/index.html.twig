{% extends 'base.html.twig' %}

{% block title %}
    Taxi Paris Service 24 | Taxi et chauffeur privé
{% endblock %}

{% block meta_description %}
    Réservez votre taxi ou chauffeur privé à Paris 24h/24
    et 7j/7, avec des tarifs fixes et transparents.
{% endblock %}

{% block body_class %}home-body{% endblock %}

{% block body %}
<div class="home-page">
    <header class="site-header">
        <div class="site-header__inner">
            <a
                class="site-brand"
                href="{{ path('app_home') }}"
                aria-label="Taxi Paris Service 24 - Accueil"
            >
                <strong>Taxi Paris</strong>
                <span>Service 24</span>
            </a>

            <button
                class="site-menu-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="main-navigation"
                aria-label="Ouvrir le menu"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="site-menu" id="main-navigation">
                <nav class="site-nav" aria-label="Navigation principale">
                    <a class="is-active" href="{{ path('app_home') }}">
                        Accueil
                    </a>
                    <a href="{{ path('app_home') }}#services">
                        Services
                    </a>
                    <a href="{{ path('app_home') }}#tarifs">
                        Tarifs
                    </a>
                    <a href="{{ path('app_home') }}#faq">
                        FAQ
                    </a>
                    <a href="/reservation.html">
                        Réservation
                    </a>
                    <a href="{{ path('app_home') }}#contact">
                        Contact
                    </a>
                </nav>

                <div class="site-header__actions">
                    <a class="header-phone" href="tel:+33184802305">
                        <span aria-hidden="true">☎</span>
                        01 84 80 23 05
                    </a>

                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a
                                class="header-button header-button--outline"
                                href="{{ path('app_admin_reservations') }}"
                            >
                                Administration
                            </a>
                        {% endif %}

                        <a
                            class="header-button header-button--outline"
                            href="{{ path('app_account') }}"
                        >
                            Mon compte
                        </a>

                        <a
                            class="header-button header-button--primary"
                            href="{{ path('app_logout') }}"
                        >
                            Déconnexion
                        </a>
                    {% else %}
                        <a
                            class="header-button header-button--outline"
                            href="{{ path('app_login') }}"
                        >
                            <span aria-hidden="true">●</span>
                            Connexion
                        </a>

                        <div class="register-action">
                            <div class="register-hint">
                                Nouveau ? Créez votre compte ici
                            </div>

                            <a
                                class="header-button header-button--primary"
                                href="{{ path('app_register') }}"
                            >
                                Créer un compte
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="home-hero">
            <div class="home-hero__overlay"></div>

            <div class="home-container home-hero__content">
                <div class="hero-copy">
                    <p class="hero-label">
                        Taxi premium à Paris
                    </p>

                    <h1>
                        Votre trajet.<br>
                        Notre priorité.
                    </h1>

                    <p class="hero-service">
                        Taxi et chauffeur privé
                    </p>

                    <p class="hero-description">
                        Profitez d’un service de transport fiable et
                        ponctuel. Nos chauffeurs professionnels assurent
                        vos déplacements 24h/24 et 7j/7, avec des tarifs
                        fixes et transparents.
                    </p>

                    <div class="hero-actions">
                        <a
                            class="hero-button hero-button--primary"
                            href="/reservation.html"
                        >
                            Réserver maintenant
                        </a>

                        <a
                            class="hero-button hero-button--outline"
                            href="tel:+33184802305"
                        >
                            <span aria-hidden="true">☎</span>
                            Appeler
                        </a>
                    </div>
                </div>

                <aside class="hero-status" aria-label="Nos engagements">
                    <div class="hero-status__item">
                        <span class="hero-status__icon">24</span>
                        <strong>24h/24</strong>
                    </div>

                    <div class="hero-status__item">
                        <span class="hero-status__icon">⌚</span>
                        <strong>Réservation rapide</strong>
                    </div>

                    <div class="hero-status__item">
                        <span class="hero-status__icon">✓</span>
                        <strong>Chauffeur confirmé</strong>
                    </div>
                </aside>
            </div>
        </section>

        <section class="home-preview" id="services">
            <div class="home-container">
                <p>La suite de la page arrive à l’étape suivante.</p>
            </div>
        </section>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const button = document.querySelector('.site-menu-toggle');
        const menu = document.querySelector('.site-menu');

        if (!button || !menu) {
            return;
        }

        button.addEventListener('click', () => {
            const isOpen = menu.classList.toggle('is-open');

            button.setAttribute(
                'aria-expanded',
                isOpen ? 'true' : 'false'
            );
        });
    });
</script>
{% endblock %}