{% extends 'base.html.twig' %}

{% block title %}
Taxi Paris Service 24 | Taxi et chauffeur privé
{% endblock %}

{% block meta_description %}
Réservez votre taxi ou chauffeur privé à Paris 24h/24
et 7j/7, avec des tarifs fixes et transparents.
{% endblock %}

{% block body_class %}home-body{% endblock %}

{% block body %}
<div class="home-page">
    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" href="{{ path('app_home') }}" aria-label="Taxi Paris Service 24 - Accueil">
                <strong>Taxi Paris</strong>
                <span>Service 24</span>
            </a>

            <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation"
                aria-label="Ouvrir le menu">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="site-menu" id="main-navigation">
                <nav class="site-nav" aria-label="Navigation principale">
                    <a class="is-active" href="{{ path('app_home') }}">
                        Accueil
                    </a>
                    <a href="{{ path('app_home') }}#services">
                        Services
                    </a>
                    <a href="{{ path('app_home') }}#tarifs">
                        Tarifs
                    </a>
                    <a href="{{ path('app_home') }}#faq">
                        FAQ
                    </a>
                    <a href="/reservation.html">
                        Réservation
                    </a>
                    <a href="{{ path('app_home') }}#contact">
                        Contact
                    </a>
                </nav>

                <div class="site-header__actions">
                    <a class="header-phone" href="tel:+33184802305">
                        <span aria-hidden="true">☎</span>
                        01 84 80 23 05
                    </a>

                    {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                    <a class="header-button header-button--outline" href="{{ path('app_admin_reservations') }}">
                        Administration
                    </a>
                    {% endif %}

                    <a class="header-button header-button--outline" href="{{ path('app_account') }}">
                        Mon compte
                    </a>

                    <a class="header-button header-button--primary" href="{{ path('app_logout') }}">
                        Déconnexion
                    </a>
                    {% else %}
                    <a class="header-button header-button--outline" href="{{ path('app_login') }}">
                        <span aria-hidden="true">●</span>
                        Connexion
                    </a>

                    <div class="register-action">
                        <div class="register-hint">
                            Nouveau ? Créez votre compte ici
                        </div>

                        <a class="header-button header-button--primary" href="{{ path('app_register') }}">
                            Créer un compte
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="home-hero">
            <div class="home-hero__overlay"></div>

            <div class="home-container home-hero__content">
                <div class="hero-copy">
                    <p class="hero-label">
                        Taxi premium à Paris
                    </p>

                    <h1>
                        Votre trajet.<br>
                        Notre priorité.
                    </h1>

                    <p class="hero-service">
                        Taxi et chauffeur privé
                    </p>

                    <p class="hero-description">
                        Profitez d’un service de transport fiable et
                        ponctuel. Nos chauffeurs professionnels assurent
                        vos déplacements 24h/24 et 7j/7, avec des tarifs
                        fixes et transparents.
                    </p>

                    <div class="hero-actions">
                        <a class="hero-button hero-button--primary" href="/reservation.html">
                            Réserver maintenant
                        </a>

                        <a class="hero-button hero-button--outline" href="tel:+33184802305">
                            <span aria-hidden="true">☎</span>
                            Appeler
                        </a>
                    </div>
                </div>

                <aside class="hero-status" aria-label="Nos engagements">
                    <div class="hero-status__item">
                        <span class="hero-status__icon">24</span>
                        <strong>24h/24</strong>
                    </div>

                    <div class="hero-status__item">
                        <span class="hero-status__icon">⌚</span>
                        <strong>Réservation rapide</strong>
                    </div>

                    <div class="hero-status__item">
                        <span class="hero-status__icon">✓</span>
                        <strong>Chauffeur confirmé</strong>
                    </div>
                </aside>
            </div>
        </section>

        <section class="loyalty-section" aria-labelledby="loyalty-title">
            {% set progress = loyaltyProgress ?? 0 %}

            <div class="home-container loyalty-layout">
                <div class="loyalty-copy">
                    <p class="section-label">
                        Service_24
                    </p>

                    <h2 id="loyalty-title">
                        Un compte qui<br>
                        vous récompense
                    </h2>

                    <p>
                        Après 5 trajets terminés, profitez automatiquement
                        de 10 % de réduction sur votre 6ᵉ course.
                    </p>

                    {% if app.user %}
                    <a class="loyalty-button" href="{{ path('app_account') }}">
                        Voir mon compte
                        <span aria-hidden="true">››</span>
                    </a>
                    {% else %}
                    <a class="loyalty-button" href="{{ path('app_register') }}">
                        Créer mon compte
                        <span aria-hidden="true">››</span>
                    </a>
                    {% endif %}
                </div>

                <div class="loyalty-card">
                    <div class="loyalty-card__header">
                        <div>
                            <p>Progression membre</p>

                            {% if app.user %}
                            <span>
                                {{ progress }}/5 trajets terminés
                            </span>
                            {% else %}
                            <span>
                                Inscription gratuite
                            </span>
                            {% endif %}
                        </div>

                        <span class="loyalty-card__badge">
                            −10 %
                        </span>
                    </div>

                    <div class="loyalty-steps" aria-label="Progression de la fidélité">
                        {% for ride in 1..5 %}
                        <div class="loyalty-step
                            {{ ride <= progress
                                ? 'is-complete'
                                : ''
                            }}">
                            <span>{{ ride }}</span>
                        </div>
                        {% endfor %}

                        <div class="loyalty-step loyalty-step--reward
                        {{ progress >= 5 ? 'is-ready' : '' }}">
                            <span>6</span>
                        </div>
                    </div>

                    <div class="loyalty-card__message">
                        {% if not app.user %}
                        <strong>Votre 6ᵉ course à −10 %</strong>

                        <p>
                            Créez votre compte pour commencer
                            à cumuler vos trajets.
                        </p>
                        {% elseif progress >= 5 %}
                        <strong>Votre remise est prête !</strong>

                        <p>
                            10 % seront automatiquement appliqués
                            à votre prochaine réservation.
                        </p>
                        {% else %}
                        <strong>
                            Encore {{ ridesUntilDiscount }}
                            trajet{{ ridesUntilDiscount > 1 ? 's' : '' }}
                        </strong>

                        <p>
                            avant de profiter de 10 % de réduction
                            sur votre prochaine course.
                        </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        <section class="services-section" id="services" aria-labelledby="services-title">
            <div class="home-container">
                <header class="services-heading">
                    <div>
                        <p class="section-label">
                            Nos services
                        </p>

                        <h2 id="services-title">
                            Le bon service<br>
                            pour chaque trajet
                        </h2>
                    </div>

                    <p class="services-heading__text">
                        Taxi et chauffeur privé disponibles 24h/24 et 7j/7
                        pour vos déplacements à Paris, en Île-de-France
                        et au-delà, avec des tarifs fixes et transparents.
                    </p>
                </header>

                <div class="services-grid">
                    <article class="service-card">
                        <div class="service-card__image">
                            <img src="/images/services/airport-transfer.png"
                                alt="Chauffeur accueillant une cliente à l’aéroport" width="1672" height="941"
                                loading="lazy">

                            <span class="service-card__number">01</span>
                        </div>

                        <div class="service-card__content">
                            <p class="service-card__label">
                                Aéroports parisiens
                            </p>

                            <h3>Transferts aéroports</h3>

                            <p>
                                Voyagez sereinement vers ou depuis Orly,
                                Roissy–Charles-de-Gaulle et Beauvais.
                                Votre chauffeur vous accueille à l’heure convenue.
                            </p>

                            <a href="{{ path('app_reservation_airport') }}">
                                Réserver un transfert
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-card__image">
                            <img src="/images/services/station-transfer.png"
                                alt="Chauffeur accueillant une cliente devant une gare parisienne" width="1672"
                                height="941" loading="lazy">

                            <span class="service-card__number">02</span>
                        </div>

                        <div class="service-card__content">
                            <p class="service-card__label">
                                Gares de Paris
                            </p>

                            <h3>Gares parisiennes</h3>

                            <p>
                                Rejoignez Gare du Nord, Gare de Lyon,
                                Montparnasse, Saint-Lazare et les autres
                                gares parisiennes sans stress.
                            </p>

                            <a href="{{ path('app_reservation_station') }}">
                                Réserver vers une gare
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-card__image">
                            <img src="/images/services/business-transfer.png"
                                alt="Chauffeur privé accompagnant une cliente professionnelle" width="1672" height="941"
                                loading="lazy">

                            <span class="service-card__number">03</span>
                        </div>

                        <div class="service-card__content">
                            <p class="service-card__label">
                                Service professionnel
                            </p>

                            <h3>Trajets professionnels</h3>

                            <p>
                                Un chauffeur discret et ponctuel pour
                                vos rendez-vous, séminaires, événements
                                et déplacements professionnels.
                            </p>

                            <a href="{{ path('app_reservation_business') }}">
                                Réserver un trajet
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-card__image">
                            <img src="/images/services/long-distance.png"
                                alt="Passagère voyageant confortablement sur une longue distance" width="1672"
                                height="941" loading="lazy">

                            <span class="service-card__number">04</span>
                        </div>

                        <div class="service-card__content">
                            <p class="service-card__label">
                                France et Europe
                            </p>

                            <h3>Longues distances</h3>

                            <p>
                                Partez depuis Paris ou l’Île-de-France
                                vers la destination de votre choix,
                                partout en France et en Europe.
                            </p>

                            <a href="{{ path('app_reservation_long_distance') }}">
                                Réserver longue distance
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="fleet-section" id="fleet" aria-labelledby="fleet-title">
            <div class="home-container">
                <header class="fleet-heading">
                    <div>
                        <p class="section-label section-label--dark">
                            Notre flotte
                        </p>

                        <h2 id="fleet-title">
                            Le confort adapté<br>
                            à votre trajet
                        </h2>
                    </div>

                    <p class="fleet-heading__text">
                        Choisissez le véhicule qui correspond à votre trajet,
                        au nombre de passagers et à vos bagages.
                    </p>
                </header>

                <div class="fleet-carousel" data-fleet-carousel aria-roledescription="carousel"
                    aria-label="Choix du véhicule">
                    <div class="fleet-carousel__viewport">
                        <div class="fleet-carousel__track">
                            <article class="fleet-card is-active" data-fleet-slide aria-hidden="false">
                                <div class="fleet-card__visual">
                                    <span class="fleet-card__number">01</span>

                                    <span class="fleet-card__category">
                                        Éco électrique
                                    </span>

                                    <img src="/images/vehicles/tesla-model-3-2026.png" alt="Tesla Model 3 noire 2026"
                                        width="1536" height="1024" loading="lazy">
                                </div>

                                <div class="fleet-card__content">
                                    <p class="fleet-card__eyebrow">
                                        Silencieuse · Moderne · Électrique
                                    </p>

                                    <h3>Tesla Model 3</h3>

                                    <p class="fleet-card__year">Modèle 2026</p>

                                    <p class="fleet-card__description">
                                        Une berline électrique silencieuse et moderne,
                                        idéale pour vos trajets quotidiens à Paris
                                        et en Île-de-France.
                                    </p>

                                    <div class="fleet-card__specs">
                                        <span>4 passagers</span>
                                        <span>3 bagages</span>
                                    </div>

                                    <a class="fleet-card__button" href="/reservation.html?vehicle=eco">
                                        Choisir ce véhicule
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </article>

                            <article class="fleet-card" data-fleet-slide aria-hidden="true">
                                <div class="fleet-card__visual">
                                    <span class="fleet-card__number">02</span>

                                    <span class="fleet-card__category">
                                        Berline premium
                                    </span>

                                    <img src="/images/vehicles/mercedes-classe-e-2026.png"
                                        alt="Mercedes Classe E noire 2026" width="1536" height="1024" loading="lazy">
                                </div>

                                <div class="fleet-card__content">
                                    <p class="fleet-card__eyebrow">
                                        Élégante · Spacieuse · Premium
                                    </p>

                                    <h3>Mercedes Classe E</h3>

                                    <p class="fleet-card__year">Modèle 2026</p>

                                    <p class="fleet-card__description">
                                        Une berline haut de gamme pour voyager avec
                                        élégance, confort et discrétion lors de vos
                                        déplacements privés ou professionnels.
                                    </p>

                                    <div class="fleet-card__specs">
                                        <span>4 passagers</span>
                                        <span>3 bagages</span>
                                    </div>

                                    <a class="fleet-card__button" href="/reservation.html?vehicle=berline">
                                        Choisir ce véhicule
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </article>

                            <article class="fleet-card" data-fleet-slide aria-hidden="true">
                                <div class="fleet-card__visual">
                                    <span class="fleet-card__number">03</span>

                                    <span class="fleet-card__category">
                                        Van premium
                                    </span>

                                    <img src="/images/vehicles/mercedes-classe-v-2026.png"
                                        alt="Mercedes Classe V noir 2026" width="1536" height="1024" loading="lazy">
                                </div>

                                <div class="fleet-card__content">
                                    <p class="fleet-card__eyebrow">
                                        Spacieux · Confortable · Polyvalent
                                    </p>

                                    <h3>Mercedes Classe V</h3>

                                    <p class="fleet-card__year">Modèle 2026</p>

                                    <p class="fleet-card__description">
                                        L’espace idéal pour les familles, les groupes
                                        et les voyageurs avec plusieurs bagages,
                                        sans renoncer au confort premium.
                                    </p>

                                    <div class="fleet-card__specs">
                                        <span>7 passagers</span>
                                        <span>7 bagages</span>
                                    </div>

                                    <a class="fleet-card__button" href="/reservation.html?vehicle=van">
                                        Choisir ce véhicule
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </article>
                        </div>
                    </div>

                    <div class="fleet-carousel__controls">
                        <button class="fleet-carousel__arrow" type="button" data-fleet-previous
                            aria-label="Afficher le véhicule précédent">
                            ←
                        </button>

                        <div class="fleet-carousel__pagination">
                            <span data-fleet-current>01</span>
                            <span class="fleet-carousel__separator"></span>
                            <span>03</span>
                        </div>

                        <div class="fleet-carousel__dots" aria-label="Choisir un véhicule">
                            <button class="is-active" type="button" data-fleet-dot="0"
                                aria-label="Afficher la Tesla Model 3" aria-current="true"></button>

                            <button type="button" data-fleet-dot="1" aria-label="Afficher la Mercedes Classe E"
                                aria-current="false"></button>

                            <button type="button" data-fleet-dot="2" aria-label="Afficher la Mercedes Classe V"
                                aria-current="false"></button>
                        </div>

                        <button class="fleet-carousel__arrow" type="button" data-fleet-next
                            aria-label="Afficher le véhicule suivant">
                            →
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuButton = document.querySelector('.site-menu-toggle');
        const menu = document.querySelector('.site-menu');

        if (menuButton && menu) {
            menuButton.addEventListener('click', () => {
                const isOpen = menu.classList.toggle('is-open');

                menuButton.setAttribute(
                    'aria-expanded',
                    isOpen ? 'true' : 'false'
                );
            });
        }

        const carousel = document.querySelector('[data-fleet-carousel]');

        if (!carousel) {
            return;
        }

        const track = carousel.querySelector('.fleet-carousel__track');
        const viewport = carousel.querySelector(
            '.fleet-carousel__viewport'
        );
        const slides = Array.from(
            carousel.querySelectorAll('[data-fleet-slide]')
        );
        const dots = Array.from(
            carousel.querySelectorAll('[data-fleet-dot]')
        );
        const previousButton = carousel.querySelector(
            '[data-fleet-previous]'
        );
        const nextButton = carousel.querySelector('[data-fleet-next]');
        const currentIndicator = carousel.querySelector(
            '[data-fleet-current]'
        );

        let currentIndex = 0;
        let pointerStartX = null;

        const displaySlide = (requestedIndex) => {
            currentIndex = (
                requestedIndex + slides.length
            ) % slides.length;

            slides.forEach((slide, index) => {
                const previousIndex = (
                    currentIndex - 1 + slides.length
                ) % slides.length;

                const nextIndex = (
                    currentIndex + 1
                ) % slides.length;

                const isActive = index === currentIndex;

                slide.classList.remove(
                    'is-active',
                    'is-previous',
                    'is-next'
                );

                if (isActive) {
                    slide.classList.add('is-active');
                } else if (index === previousIndex) {
                    slide.classList.add('is-previous');
                } else if (index === nextIndex) {
                    slide.classList.add('is-next');
                }

                slide.setAttribute(
                    'aria-hidden',
                    isActive ? 'false' : 'true'
                );

                slide.toggleAttribute('inert', !isActive);
            });

            dots.forEach((dot, index) => {
                const isActive = index === currentIndex;

                dot.classList.toggle('is-active', isActive);
                dot.setAttribute(
                    'aria-current',
                    isActive ? 'true' : 'false'
                );
            });

            currentIndicator.textContent = String(
                currentIndex + 1
            ).padStart(2, '0');
        };

        previousButton?.addEventListener('click', () => {
            displaySlide(currentIndex - 1);
        });

        nextButton?.addEventListener('click', () => {
            displaySlide(currentIndex + 1);
        });

        dots.forEach((dot) => {
            dot.addEventListener('click', () => {
                displaySlide(Number(dot.dataset.fleetDot));
            });
        });

        carousel.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') {
                displaySlide(currentIndex - 1);
            }

            if (event.key === 'ArrowRight') {
                displaySlide(currentIndex + 1);
            }
        });

        viewport.addEventListener('pointerdown', (event) => {
            pointerStartX = event.clientX;
        });

        viewport.addEventListener('pointerup', (event) => {
            if (pointerStartX === null) {
                return;
            }

            const movement = event.clientX - pointerStartX;

            if (Math.abs(movement) >= 50) {
                displaySlide(
                    movement < 0
                        ? currentIndex + 1
                        : currentIndex - 1
                );
            }

            pointerStartX = null;
        });

        viewport.addEventListener('pointercancel', () => {
            pointerStartX = null;
        });

        displaySlide(0);
    });
</script>
{% endblock %}