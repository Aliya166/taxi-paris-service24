{% extends 'base.html.twig' %}

{% block title %}Réservations | Administration{% endblock %}

{% block body_class %}admin-body{% endblock %}

{% block body %}

<main class="admin-page" data-controller="confirm-modal">

    <div class="admin-shell">

        {# =========================
        HEADER
        ========================= #}

        <header class="admin-page-header">

            <div>
                <p class="admin-kicker">
                    Taxi Paris Service 24 · Administration
                </p>

                <h1>Gestion des réservations</h1>

                <p class="admin-page-description">
                    Consultez, recherchez et gérez les demandes de réservation.
                </p>
            </div>

            <a class="admin-back-link" href="{{ path('app_account') }}">
                ← Retour à mon compte
            </a>

        </header>


        {# =========================
        STATISTICS
        ========================= #}

        <section class="admin-stats">

            <article class="admin-stat-card">
                <span class="admin-stat-label">
                    Résultats affichés
                </span>

                <strong class="admin-stat-value">
                    {{ reservations|length }}
                </strong>

                <span class="admin-stat-text">
                    Réservations correspondant aux filtres
                </span>
            </article>


            <article class="admin-stat-card">
                <span class="admin-stat-label">
                    En attente
                </span>

                <strong class="admin-stat-value">
                    {{ reservations|filter(r => r.status.value == 'pending')|length }}
                </strong>

                <span class="admin-stat-text">
                    Demandes à traiter
                </span>
            </article>


            <article class="admin-stat-card">
                <span class="admin-stat-label">
                    Confirmées
                </span>

                <strong class="admin-stat-value">
                    {{ reservations|filter(r => r.status.value == 'confirmed')|length }}
                </strong>

                <span class="admin-stat-text">
                    Courses confirmées
                </span>
            </article>

        </section>


        {# =========================
        FILTERS
        ========================= #}

        <section class="admin-panel">

            <div class="admin-panel-heading">
                <div>
                    <p class="admin-panel-kicker">
                        Recherche
                    </p>

                    <h2>
                        Rechercher une réservation
                    </h2>
                </div>
            </div>


            <form class="admin-filters" method="get" action="{{ path('app_admin_reservations') }}">

                <div class="admin-filter-field admin-filter-field--search">

                    <label for="reservation-search">
                        Rechercher
                    </label>

                    <input id="reservation-search" type="search" name="q" value="{{ search }}"
                        placeholder="Référence, client, email ou téléphone">

                </div>


                <div class="admin-filter-field">

                    <label for="reservation-status">
                        Statut
                    </label>

                    <select id="reservation-status" name="status">

                        <option value="" {% if selectedStatus is null %}selected{% endif %}>
                            Tous les statuts
                        </option>

                        {% for status in statuses %}

                        <option value="{{ status.value }}" {% if selectedStatus==status.value %}selected{% endif %}>
                            {{ status.label() }}
                        </option>

                        {% endfor %}

                    </select>

                </div>


                <div class="admin-filter-field">

                    <label for="reservation-date-from">
                        Du
                    </label>

                    <input id="reservation-date-from" type="date" name="date_from" value="{{ selectedDateFrom }}" {% if
                        selectedDateTo %} max="{{ selectedDateTo }}" {% endif %}>

                </div>


                <div class="admin-filter-field">

                    <label for="reservation-date-to">
                        Au
                    </label>

                    <input id="reservation-date-to" type="date" name="date_to" value="{{ selectedDateTo }}" {% if
                        selectedDateFrom %} min="{{ selectedDateFrom }}" {% endif %}>

                </div>


                <button class="admin-button admin-button--dark" type="submit">
                    Rechercher
                </button>


                <a class="admin-button admin-button--secondary" href="{{ path('app_admin_reservations') }}">
                    Réinitialiser
                </a>

            </form>

        </section>


        {# =========================
        FLASH MESSAGES
        ========================= #}

        {% for label, messages in app.flashes %}

        {% for message in messages %}

        <div class="admin-flash admin-flash--{{ label }}" role="alert">
            {{ message }}
        </div>

        {% endfor %}

        {% endfor %}


        {# =========================
        RESERVATIONS TABLE
        ========================= #}

        <section class="admin-panel admin-reservations-panel">

            <div class="admin-panel-heading">

                <div>
                    <p class="admin-panel-kicker">
                        Activité
                    </p>

                    <h2>
                        Réservations
                    </h2>
                </div>

                <span class="admin-result-count">
                    {{ reservations|length }} résultat(s)
                </span>

            </div>


            {% if reservations is empty %}

            <div class="admin-empty-state">

                <div class="admin-empty-symbol">
                    —
                </div>

                <h3>
                    Aucune réservation trouvée
                </h3>

                <p>
                    Modifiez vos critères de recherche ou réinitialisez les filtres.
                </p>

            </div>

            {% else %}

            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>

                        <tr>
                            <th>Référence</th>
                            <th>Statut</th>
                            <th>Client</th>
                            <th>Trajet</th>
                            <th>Date</th>
                            <th>Véhicule</th>
                            <th>Prix</th>
                            <th>Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        {% for reservation in reservations %}

                        <tr>

                            <td>

                                <a class="admin-reference" href="{{ path(
                                                'app_admin_reservation_show',
                                                { id: reservation.id }
                                            ) }}">
                                    {{ reservation.reference }}
                                </a>

                            </td>


                            <td>

                                <span class="admin-status admin-status--{{ reservation.status.value }}">
                                    {{ reservation.status.label() }}
                                </span>

                            </td>


                            <td>

                                <strong class="admin-client-name">
                                    {{ reservation.firstName }}
                                    {{ reservation.lastName }}
                                </strong>

                                <a class="admin-contact-link" href="mailto:{{ reservation.email }}">
                                    {{ reservation.email }}
                                </a>

                                <a class="admin-contact-link" href="tel:{{ reservation.phone }}">
                                    {{ reservation.phone }}
                                </a>

                            </td>


                            <td>

                                <div class="admin-route">

                                    <div class="admin-route-point">

                                        <span class="admin-route-dot"></span>

                                        <span>
                                            {{ reservation.pickupAddress }}
                                        </span>

                                    </div>


                                    <span class="admin-route-line"></span>


                                    <div class="admin-route-point">

                                        <span class="admin-route-dot admin-route-dot--end"></span>

                                        <span>
                                            {{ reservation.dropoffAddress }}
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <span class="admin-date">
                                    {{ reservation.scheduledAt|date('d/m/Y') }}
                                </span>

                                <strong class="admin-time">
                                    {{ reservation.scheduledAt|date('H:i') }}
                                </strong>

                            </td>


                            <td>
                                {{ reservation.vehicleType.label() }}
                            </td>


                            <td>

                                {% if reservation.finalPrice is not null %}

                                <strong class="admin-price">
                                    {{ reservation.finalPrice|number_format(2, ',', ' ') }} €
                                </strong>

                                {% else %}

                                <span class="admin-muted">
                                    À confirmer
                                </span>

                                {% endif %}

                            </td>


                            <td class="admin-actions">


                                {% if reservation.status.value == 'pending' %}

                                <form method="post" action="{{ path(
                                                    'app_admin_reservation_status',
                                                    {
                                                        id: reservation.id,
                                                        action: 'confirm'
                                                    }
                                                ) }}">

                                    <input type="hidden" name="_token" value="{{ csrf_token(
                                                        'admin_reservation_status_'
                                                        ~ reservation.id
                                                        ~ '_confirm'
                                                    ) }}">

                                    <button type="submit" class="admin-action-button admin-action-button--confirm">
                                        Confirmer
                                    </button>

                                </form>

                                {% endif %}


                                {% if reservation.status.value == 'confirmed' %}

                                <form method="post" action="{{ path(
                                                    'app_admin_reservation_status',
                                                    {
                                                        id: reservation.id,
                                                        action: 'complete'
                                                    }
                                                ) }}">

                                    <input type="hidden" name="_token" value="{{ csrf_token(
                                                        'admin_reservation_status_'
                                                        ~ reservation.id
                                                        ~ '_complete'
                                                    ) }}">

                                    <button type="submit" class="admin-action-button admin-action-button--complete">
                                        Terminer
                                    </button>

                                </form>

                                {% endif %}


                                {% if reservation.status.value in ['pending', 'confirmed'] %}

                                <form method="post" action="{{ path(
        'app_admin_reservation_status',
        {
            id: reservation.id,
            action: 'cancel'
        }
    ) }}" data-action="submit->confirm-modal#open" data-confirm-title="Annuler la réservation"
                                    data-confirm-message="Confirmez-vous l’annulation de cette réservation ? Le client sera informé de cette modification."
                                    data-confirm-button="Confirmer l’annulation">

                                    <input type="hidden" name="_token" value="{{ csrf_token(
                                                        'admin_reservation_status_'
                                                        ~ reservation.id
                                                        ~ '_cancel'
                                                    ) }}">

                                    <button type="submit" class="admin-action-button admin-action-button--cancel">
                                        Annuler
                                    </button>

                                </form>

                                {% else %}

                                <span class="admin-muted">
                                    Aucune action
                                </span>

                                {% endif %}


                            </td>

                        </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

            {% endif %}

        </section>

    </div>

    {% include 'partials/_confirm_modal.html.twig' %}

</main>

{% endblock %}