{% extends 'base.html.twig' %}

{% block title %}
Réservation {{ reservation.reference }} | Administration
{% endblock %}

{% block body_class %}admin-body{% endblock %}

{% block body %}

<main class="admin-page admin-reservation-detail-page">

    <div class="admin-shell">

        <header class="admin-page-header admin-detail-header">

            <div>

                <p class="admin-kicker">
                    Taxi Paris Service 24 · Administration
                </p>

                <a
                    class="admin-detail-back"
                    href="{{ path('app_admin_reservations') }}"
                >
                    ← Retour aux réservations
                </a>

                <h1>
                    {{ reservation.reference }}
                </h1>

                <div class="admin-detail-header-meta">

                    <span
                        class="admin-status admin-status--{{ reservation.status.value }}"
                    >
                        {{ reservation.status.label() }}
                    </span>

                    <span class="admin-detail-created">
                        Créée le {{ reservation.createdAt|date('d/m/Y à H:i') }}
                    </span>

                </div>

            </div>

            <a
                class="admin-back-link"
                href="{{ path('app_account') }}"
            >
                Retour à mon compte
            </a>

        </header>


        <section class="admin-detail-grid">

            {# CLIENT #}

            <article class="admin-detail-card">

                <div class="admin-detail-card-heading">
                    <span class="admin-detail-number">01</span>

                    <div>
                        <p class="admin-panel-kicker">
                            Client
                        </p>

                        <h2>
                            Informations client
                        </h2>
                    </div>
                </div>

                <dl class="admin-detail-list">

                    <div>
                        <dt>Nom</dt>

                        <dd>
                            {{ reservation.firstName }}
                            {{ reservation.lastName }}
                        </dd>
                    </div>

                    <div>
                        <dt>Email</dt>

                        <dd>
                            <a href="mailto:{{ reservation.email }}">
                                {{ reservation.email }}
                            </a>
                        </dd>
                    </div>

                    <div>
                        <dt>Téléphone</dt>

                        <dd>
                            <a href="tel:{{ reservation.phone }}">
                                {{ reservation.phone }}
                            </a>
                        </dd>
                    </div>

                    <div>
                        <dt>Compte client</dt>

                        <dd>
                            {% if reservation.customer %}
                                Oui
                            {% else %}
                                Non
                            {% endif %}
                        </dd>
                    </div>

                </dl>

            </article>


            {# RESERVATION #}

            <article class="admin-detail-card">

                <div class="admin-detail-card-heading">
                    <span class="admin-detail-number">02</span>

                    <div>
                        <p class="admin-panel-kicker">
                            Réservation
                        </p>

                        <h2>
                            Informations course
                        </h2>
                    </div>
                </div>

                <dl class="admin-detail-list">

                    <div>
                        <dt>Date</dt>

                        <dd>
                            {{ reservation.scheduledAt|date('d/m/Y à H:i') }}
                        </dd>
                    </div>

                    <div>
                        <dt>Type</dt>

                        <dd>
                            {{ reservation.type.label() }}
                        </dd>
                    </div>

                    <div>
                        <dt>Véhicule</dt>

                        <dd>
                            {{ reservation.vehicleType.label() }}
                        </dd>
                    </div>

                    <div>
                        <dt>Passagers</dt>

                        <dd>
                            {{ reservation.passengers }}
                        </dd>
                    </div>

                    <div>
                        <dt>Bagages</dt>

                        <dd>
                            {{ reservation.luggage }}
                        </dd>
                    </div>

                    <div>
                        <dt>Siège enfant</dt>

                        <dd>
                            {% if reservation.childSeatRequested %}
                                Oui
                            {% else %}
                                Non
                            {% endif %}
                        </dd>
                    </div>

                    {% if reservation.transportReference %}

                        <div>
                            <dt>Référence transport</dt>

                            <dd>
                                {{ reservation.transportReference }}
                            </dd>
                        </div>

                    {% endif %}

                </dl>

            </article>


            {# TRAJET #}

            <article class="admin-detail-card admin-detail-card--wide">

                <div class="admin-detail-card-heading">
                    <span class="admin-detail-number">03</span>

                    <div>
                        <p class="admin-panel-kicker">
                            Trajet
                        </p>

                        <h2>
                            Itinéraire
                        </h2>
                    </div>
                </div>


                <div class="admin-detail-route">

                    <div class="admin-detail-route-point">

                        <span class="admin-detail-route-marker"></span>

                        <div>
                            <span class="admin-detail-route-label">
                                Départ
                            </span>

                            <strong>
                                {{ reservation.pickupAddress }}
                            </strong>
                        </div>

                    </div>


                    <div class="admin-detail-route-connector"></div>


                    <div class="admin-detail-route-point">

                        <span class="admin-detail-route-marker admin-detail-route-marker--end"></span>

                        <div>
                            <span class="admin-detail-route-label">
                                Arrivée
                            </span>

                            <strong>
                                {{ reservation.dropoffAddress }}
                            </strong>
                        </div>

                    </div>

                </div>


                <div class="admin-detail-metrics">

                    <div>
                        <span>Distance</span>

                        <strong>
                            {% if reservation.distanceKm is not null %}
                                {{ reservation.distanceKm|number_format(1, ',', ' ') }} km
                            {% else %}
                                —
                            {% endif %}
                        </strong>
                    </div>

                    <div>
                        <span>Durée estimée</span>

                        <strong>
                            {% if reservation.durationMinutes is not null %}
                                {{ reservation.durationMinutes }} min
                            {% else %}
                                —
                            {% endif %}
                        </strong>
                    </div>

                </div>

            </article>


            {# TARIFICATION #}

            <article class="admin-detail-card">

                <div class="admin-detail-card-heading">
                    <span class="admin-detail-number">04</span>

                    <div>
                        <p class="admin-panel-kicker">
                            Tarification
                        </p>

                        <h2>
                            Prix
                        </h2>
                    </div>
                </div>

                <dl class="admin-detail-list">

                    <div>
                        <dt>Prix de base</dt>

                        <dd>
                            {% if reservation.basePrice is not null %}
                                {{ reservation.basePrice|number_format(2, ',', ' ') }} €
                            {% else %}
                                —
                            {% endif %}
                        </dd>
                    </div>


                    <div>
                        <dt>Remise</dt>

                        <dd>
                            {% if reservation.discountPercentage %}
                                {{ reservation.discountPercentage|number_format(0, ',', ' ') }} %
                            {% else %}
                                0 %
                            {% endif %}
                        </dd>
                    </div>


                    <div>
                        <dt>Montant remise</dt>

                        <dd>
                            {% if reservation.discountAmount %}
                                - {{ reservation.discountAmount|number_format(2, ',', ' ') }} €
                            {% else %}
                                0,00 €
                            {% endif %}
                        </dd>
                    </div>


                    <div class="admin-detail-total">
                        <dt>Prix final</dt>

                        <dd>
                            {% if reservation.finalPrice is not null %}
                                {{ reservation.finalPrice|number_format(2, ',', ' ') }} €
                            {% else %}
                                À confirmer
                            {% endif %}
                        </dd>
                    </div>


                    <div>
                        <dt>Remise fidélité</dt>

                        <dd>
                            {% if reservation.loyaltyDiscountApplied %}
                                Oui
                            {% else %}
                                Non
                            {% endif %}
                        </dd>
                    </div>

                </dl>

            </article>


            {# SUIVI #}

            <article class="admin-detail-card">

                <div class="admin-detail-card-heading">
                    <span class="admin-detail-number">05</span>

                    <div>
                        <p class="admin-panel-kicker">
                            Suivi
                        </p>

                        <h2>
                            Historique
                        </h2>
                    </div>
                </div>

                <dl class="admin-detail-list">

                    <div>
                        <dt>Créée</dt>

                        <dd>
                            {{ reservation.createdAt|date('d/m/Y à H:i') }}
                        </dd>
                    </div>

                    <div>
                        <dt>Dernière modification</dt>

                        <dd>
                            {{ reservation.updatedAt|date('d/m/Y à H:i') }}
                        </dd>
                    </div>

                    {% if reservation.confirmedAt %}

                        <div>
                            <dt>Confirmée</dt>

                            <dd>
                                {{ reservation.confirmedAt|date('d/m/Y à H:i') }}
                            </dd>
                        </div>

                    {% endif %}


                    {% if reservation.completedAt %}

                        <div>
                            <dt>Terminée</dt>

                            <dd>
                                {{ reservation.completedAt|date('d/m/Y à H:i') }}
                            </dd>
                        </div>

                    {% endif %}


                    {% if reservation.cancelledAt %}

                        <div>
                            <dt>Annulée</dt>

                            <dd>
                                {{ reservation.cancelledAt|date('d/m/Y à H:i') }}
                            </dd>
                        </div>

                    {% endif %}

                </dl>

            </article>


            {% if reservation.notes %}

                <article class="admin-detail-card admin-detail-card--wide">

                    <div class="admin-detail-card-heading">
                        <span class="admin-detail-number">06</span>

                        <div>
                            <p class="admin-panel-kicker">
                                Informations complémentaires
                            </p>

                            <h2>
                                Notes
                            </h2>
                        </div>
                    </div>

                    <p class="admin-detail-notes">
                        {{ reservation.notes }}
                    </p>

                </article>

            {% endif %}


            {% if reservation.cancellationReason %}

                <article class="admin-detail-card admin-detail-card--wide admin-detail-card--alert">

                    <div class="admin-detail-card-heading">

                        <span class="admin-detail-number">!</span>

                        <div>
                            <p class="admin-panel-kicker">
                                Annulation
                            </p>

                            <h2>
                                Motif d'annulation
                            </h2>
                        </div>

                    </div>

                    <p class="admin-detail-notes">
                        {{ reservation.cancellationReason }}
                    </p>

                </article>

            {% endif %}

        </section>

    </div>

</main>

{% endblock %}