{% extends 'base.html.twig' %}

{% block title %}
    Réservation {{ reservation.reference }} | Administration
{% endblock %}

{% block stylesheets %}
    <style>
        .reservation-page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 32px 20px 60px;
            color: #172033;
        }

        .reservation-back {
            display: inline-block;
            margin-bottom: 24px;
            color: #2563eb;
            text-decoration: none;
        }

        .reservation-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 28px;
        }

        .reservation-header h1 {
            margin: 4px 0 0;
            font-size: clamp(24px, 4vw, 36px);
        }

        .reservation-reference {
            margin: 0;
            color: #64748b;
        }

        .reservation-status {
            padding: 9px 14px;
            border-radius: 999px;
            font-weight: 700;
            white-space: nowrap;
            background: #e2e8f0;
        }

        .reservation-status--pending {
            color: #92400e;
            background: #fef3c7;
        }

        .reservation-status--confirmed {
            color: #1d4ed8;
            background: #dbeafe;
        }

        .reservation-status--completed {
            color: #166534;
            background: #dcfce7;
        }

        .reservation-status--cancelled {
            color: #991b1b;
            background: #fee2e2;
        }

        .reservation-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .reservation-card {
            padding: 24px;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
        }

        .reservation-card--wide {
            grid-column: 1 / -1;
        }

        .reservation-card h2 {
            margin: 0 0 20px;
            font-size: 20px;
        }

        .reservation-details {
            display: grid;
            gap: 14px;
            margin: 0;
        }

        .reservation-details div {
            display: grid;
            grid-template-columns: minmax(130px, 42%) 1fr;
            gap: 15px;
            padding-bottom: 12px;
            border-bottom: 1px solid #e2e8f0;
        }

        .reservation-details div:last-child {
            padding-bottom: 0;
            border-bottom: 0;
        }

        .reservation-details dt {
            color: #64748b;
        }

        .reservation-details dd {
            margin: 0;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .reservation-details a {
            color: #2563eb;
        }

        .reservation-notes {
            margin: 0;
            padding: 16px;
            border-radius: 10px;
            background: #f8fafc;
            white-space: pre-wrap;
        }

        .reservation-alert {
            margin-top: 22px;
            padding: 18px;
            border: 1px solid #fecaca;
            border-radius: 12px;
            color: #991b1b;
            background: #fef2f2;
        }

        @media (max-width: 750px) {
            .reservation-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .reservation-grid {
                grid-template-columns: 1fr;
            }

            .reservation-card--wide {
                grid-column: auto;
            }

            .reservation-details div {
                grid-template-columns: 1fr;
                gap: 5px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<main class="reservation-page">
    <a
        class="reservation-back"
        href="{{ path('app_admin_reservations') }}"
    >
        ← Retour aux réservations
    </a>

    <header class="reservation-header">
        <div>
            <p class="reservation-reference">Détail de la réservation</p>

            <h1>{{ reservation.reference }}</h1>
        </div>

        <span class="
            reservation-status
            reservation-status--{{ reservation.status.value }}
        ">
            {{ reservation.status.label() }}
        </span>
    </header>

    <div class="reservation-grid">
        <section class="reservation-card">
            <h2>Client</h2>

            <dl class="reservation-details">
                <div>
                    <dt>Nom complet</dt>
                    <dd>
                        {{ reservation.firstName }}
                        {{ reservation.lastName }}
                    </dd>
                </div>

                <div>
                    <dt>Email</dt>
                    <dd>
                        <a href="mailto:{{ reservation.email }}">
                            {{ reservation.email }}
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>Téléphone</dt>
                    <dd>
                        <a href="tel:{{ reservation.phone }}">
                            {{ reservation.phone }}
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>Compte client</dt>
                    <dd>
                        {% if reservation.customer %}
                            Oui
                        {% else %}
                            Réservation sans compte
                        {% endif %}
                    </dd>
                </div>
            </dl>
        </section>

        <section class="reservation-card">
            <h2>Réservation</h2>

            <dl class="reservation-details">
                <div>
                    <dt>Date du trajet</dt>
                    <dd>
                        {{ reservation.scheduledAt|date('d/m/Y à H:i') }}
                    </dd>
                </div>

                <div>
                    <dt>Type</dt>
                    <dd>{{ reservation.type.label() }}</dd>
                </div>

                <div>
                    <dt>Véhicule</dt>
                    <dd>{{ reservation.vehicleType.label() }}</dd>
                </div>

                <div>
                    <dt>Passagers</dt>
                    <dd>{{ reservation.passengers }}</dd>
                </div>

                <div>
                    <dt>Bagages</dt>
                    <dd>{{ reservation.luggage }}</dd>
                </div>

                {% if reservation.transportReference %}
                    <div>
                        <dt>Vol ou train</dt>
                        <dd>{{ reservation.transportReference }}</dd>
                    </div>
                {% endif %}
            </dl>
        </section>

        <section class="reservation-card reservation-card--wide">
            <h2>Trajet</h2>

            <dl class="reservation-details">
                <div>
                    <dt>Adresse de départ</dt>
                    <dd>{{ reservation.pickupAddress }}</dd>
                </div>

                <div>
                    <dt>Adresse d’arrivée</dt>
                    <dd>{{ reservation.dropoffAddress }}</dd>
                </div>

                <div>
                    <dt>Distance estimée</dt>
                    <dd>
                        {% if reservation.distanceKm is not null %}
                            {{ reservation.distanceKm|number_format(2, ',', ' ') }}
                            km
                        {% else %}
                            Non disponible
                        {% endif %}
                    </dd>
                </div>

                <div>
                    <dt>Durée estimée</dt>
                    <dd>
                        {% if reservation.durationMinutes is not null %}
                            {{ reservation.durationMinutes }} minutes
                        {% else %}
                            Non disponible
                        {% endif %}
                    </dd>
                </div>
            </dl>
        </section>

        <section class="reservation-card">
            <h2>Tarification</h2>

            <dl class="reservation-details">
                <div>
                    <dt>Prix initial</dt>
                    <dd>
                        {% if reservation.basePrice is not null %}
                            {{ reservation.basePrice
                                |number_format(2, ',', ' ') }} €
                        {% else %}
                            À confirmer
                        {% endif %}
                    </dd>
                </div>

                <div>
                    <dt>Réduction</dt>
                    <dd>
                        {% if reservation.discountPercentage > 0 %}
                            {{ reservation.discountPercentage }} %
                            −
                            {{ reservation.discountAmount
                                |number_format(2, ',', ' ') }} €
                        {% else %}
                            Aucune
                        {% endif %}
                    </dd>
                </div>

                <div>
                    <dt>Prix final</dt>
                    <dd>
                        {% if reservation.finalPrice is not null %}
                            {{ reservation.finalPrice
                                |number_format(2, ',', ' ') }} €
                        {% else %}
                            À confirmer
                        {% endif %}
                    </dd>
                </div>

                <div>
                    <dt>Avantage fidélité</dt>
                    <dd>
                        {% if reservation.loyaltyDiscountApplied %}
                            Appliqué
                        {% else %}
                            Non appliqué
                        {% endif %}
                    </dd>
                </div>
            </dl>
        </section>

        <section class="reservation-card">
            <h2>Suivi</h2>

            <dl class="reservation-details">
                <div>
                    <dt>Créée le</dt>
                    <dd>{{ reservation.createdAt|date('d/m/Y à H:i') }}</dd>
                </div>

                <div>
                    <dt>Dernière modification</dt>
                    <dd>{{ reservation.updatedAt|date('d/m/Y à H:i') }}</dd>
                </div>

                {% if reservation.confirmedAt %}
                    <div>
                        <dt>Confirmée le</dt>
                        <dd>
                            {{ reservation.confirmedAt
                                |date('d/m/Y à H:i') }}
                        </dd>
                    </div>
                {% endif %}

                {% if reservation.completedAt %}
                    <div>
                        <dt>Terminée le</dt>
                        <dd>
                            {{ reservation.completedAt
                                |date('d/m/Y à H:i') }}
                        </dd>
                    </div>
                {% endif %}

                {% if reservation.cancelledAt %}
                    <div>
                        <dt>Annulée le</dt>
                        <dd>
                            {{ reservation.cancelledAt
                                |date('d/m/Y à H:i') }}
                        </dd>
                    </div>
                {% endif %}
            </dl>
        </section>

        {% if reservation.notes %}
            <section class="reservation-card reservation-card--wide">
                <h2>Notes du client</h2>
                <p class="reservation-notes">{{ reservation.notes }}</p>
            </section>
        {% endif %}
    </div>

    {% if reservation.cancellationReason %}
        <div class="reservation-alert">
            <strong>Motif de l’annulation :</strong>
            {{ reservation.cancellationReason }}
        </div>
    {% endif %}
</main>
{% endblock %}