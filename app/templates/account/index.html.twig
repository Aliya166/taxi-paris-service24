{% extends 'base.html.twig' %}

{% block title %}Mon compte | Taxi Paris Service 24{% endblock %}

{% block body_class %}home-body{% endblock %}

{% block body %}

<div class="home-page" data-controller="confirm-modal">

    {% include 'partials/_site_header.html.twig' %}

    <main class="account-page">

        <section class="account-hero">

            <div class="home-container account-hero-inner">

                <div>

                    <p class="section-kicker">
                        Espace client
                    </p>

                    <h1>
                        Bonjour {{ user.firstName }}
                    </h1>

                    <p class="account-hero-text">
                        Retrouvez vos informations personnelles,
                        vos réservations et vos avantages fidélité.
                    </p>

                </div>


                <div class="account-hero-actions">

                    <a class="account-primary-button" href="{{ path('app_reservation') }}">
                        Réserver un trajet
                    </a>

                    <a class="account-secondary-button" href="{{ path('app_logout') }}">
                        Se déconnecter
                    </a>

                </div>

            </div>

        </section>


        <section class="account-content">

            <div class="home-container">


                {% for message in app.flashes('success') %}

                <div class="account-flash account-flash--success" role="status">
                    {{ message }}
                </div>

                {% endfor %}


                {% if is_granted('ROLE_ADMIN') %}

                <div class="account-admin-banner">

                    <div>
                        <span class="account-admin-kicker">
                            Administration
                        </span>

                        <strong>
                            Accès à la gestion des réservations
                        </strong>
                    </div>

                    <a href="{{ path('app_admin_reservations') }}">
                        Ouvrir l'administration
                    </a>

                </div>

                {% endif %}


                <div class="account-layout">


                    <aside class="account-sidebar">


                        <section class="account-card account-profile-card">

                            <div class="account-card-heading">

                                <div>
                                    <p class="account-card-kicker">
                                        Profil
                                    </p>

                                    <h2>
                                        Mes coordonnées
                                    </h2>
                                </div>

                            </div>


                            <dl class="account-profile-list">

                                <div>
                                    <dt>Prénom</dt>
                                    <dd>{{ user.firstName }}</dd>
                                </div>

                                <div>
                                    <dt>Nom</dt>
                                    <dd>{{ user.lastName }}</dd>
                                </div>

                                <div>
                                    <dt>Email</dt>
                                    <dd>{{ user.email }}</dd>
                                </div>

                                <div>
                                    <dt>Téléphone</dt>
                                    <dd>
                                        {% if user.phone %}
                                        {{ user.phone }}
                                        {% else %}
                                        Non renseigné
                                        {% endif %}
                                    </dd>
                                </div>

                                <div>
                                    <dt>Compte</dt>

                                    <dd>
                                        {% if user.isVerified %}

                                        <span class="account-verification account-verification--ok">
                                            Email vérifié
                                        </span>

                                        {% else %}

                                        <span class="account-verification account-verification--warning">
                                            Email à vérifier
                                        </span>

                                        {% endif %}
                                    </dd>
                                </div>

                            </dl>


                            <a class="account-edit-link" href="{{ path('app_account_edit') }}">
                                Modifier mes coordonnées →
                            </a>

                        </section>


                        <section class="account-card account-loyalty-card">

                            <div class="account-card-heading">

                                <div>
                                    <p class="account-card-kicker">
                                        Fidélité
                                    </p>

                                    <h2>
                                        Mon avantage
                                    </h2>
                                </div>

                            </div>


                            <div class="account-loyalty-count">

                                <strong>
                                    {{ completedRides > 5 ? 5 : completedRides }}
                                </strong>

                                <span>
                                    / 5 trajets
                                </span>

                            </div>


                            {% set loyaltyProgress = completedRides > 5 ? 100 : completedRides * 20 %}

                            <div class="account-progress">

                                <div class="account-progress-bar account-progress-bar--{{ loyaltyProgress }}"></div>

                            </div>


                            {% if ridesUntilDiscount > 0 %}

                            <p class="account-loyalty-text">
                                Plus que
                                <strong>{{ ridesUntilDiscount }}</strong>
                                trajet(s) terminé(s) avant de bénéficier
                                de 10 % de réduction.
                            </p>

                            {% else %}

                            <p class="account-loyalty-text">
                                Votre avantage fidélité est disponible.
                                La réduction de 10 % sera appliquée
                                automatiquement lorsqu'elle sera disponible
                                sur votre prochaine réservation.
                            </p>

                            {% endif %}

                        </section>

                    </aside>


                    <section class="account-main-column" aria-labelledby="reservations-title">

                        <div class="account-section-heading">

                            <div>

                                <p class="account-card-kicker">
                                    Historique
                                </p>

                                <h2 id="reservations-title">
                                    Mes réservations
                                </h2>

                            </div>

                            <span class="account-reservation-count">
                                {{ reservations|length }} réservation(s)
                            </span>

                        </div>


                        {% if reservations is empty %}

                        <div class="account-empty">

                            <span class="account-empty-number">
                                00
                            </span>

                            <h3>
                                Aucune réservation
                            </h3>

                            <p>
                                Vous n'avez encore aucune réservation
                                enregistrée sur votre compte.
                            </p>

                            <a class="account-primary-button" href="{{ path('app_reservation') }}">
                                Réserver maintenant
                            </a>

                        </div>

                        {% else %}


                        <div class="account-reservations">

                            {% for reservation in reservations %}

                            <article class="account-reservation-card">


                                <header class="account-reservation-header">

                                    <div>

                                        <span class="account-reservation-label">
                                            Réservation
                                        </span>

                                        <h3>
                                            {{ reservation.reference }}
                                        </h3>

                                    </div>


                                    <span class="admin-status admin-status--{{ reservation.status.value }}">
                                        {{ reservation.status.label() }}
                                    </span>

                                </header>


                                <div class="account-route">

                                    <div class="account-route-point">

                                        <span class="account-route-dot"></span>

                                        <div>

                                            <span>
                                                Départ
                                            </span>

                                            <strong>
                                                {{ reservation.pickupAddress }}
                                            </strong>

                                        </div>

                                    </div>


                                    <div class="account-route-line"></div>


                                    <div class="account-route-point">

                                        <span class="account-route-dot account-route-dot--end"></span>

                                        <div>

                                            <span>
                                                Arrivée
                                            </span>

                                            <strong>
                                                {{ reservation.dropoffAddress }}
                                            </strong>

                                        </div>

                                    </div>

                                </div>


                                <div class="account-reservation-details">

                                    <div>
                                        <span>Date</span>

                                        <strong>
                                            {{ reservation.scheduledAt|date('d/m/Y') }}
                                        </strong>

                                        <small>
                                            {{ reservation.scheduledAt|date('H:i') }}
                                        </small>
                                    </div>


                                    <div>
                                        <span>Type</span>

                                        <strong>
                                            {{ reservation.type.label() }}
                                        </strong>
                                    </div>


                                    <div>
                                        <span>Véhicule</span>

                                        <strong>
                                            {{ reservation.vehicleType.label() }}
                                        </strong>
                                    </div>


                                    <div>
                                        <span>Passagers</span>

                                        <strong>
                                            {{ reservation.passengers }}
                                        </strong>
                                    </div>


                                    <div>
                                        <span>Bagages</span>

                                        <strong>
                                            {{ reservation.luggage }}
                                        </strong>
                                    </div>


                                    <div>
                                        <span>Prix</span>

                                        {% if reservation.finalPrice is not null %}

                                        <strong class="account-reservation-price">
                                            {{ reservation.finalPrice|number_format(2, ',', ' ') }} €
                                        </strong>

                                        {% else %}

                                        <strong>
                                            À confirmer
                                        </strong>

                                        {% endif %}
                                    </div>

                                </div>


                                {% if reservation.discountPercentage > 0 %}

                                <div class="account-discount">
                                    Réduction de
                                    {{ reservation.discountPercentage }} %
                                    appliquée
                                </div>

                                {% endif %}

                                {% if reservation.status.value == 'pending' %}

                                <div class="account-reservation-edit-action">

                                    <a href="{{ path(
                'app_account_reservation_edit',
                { id: reservation.id }
            ) }}" class="account-reservation-edit-button">
                                        Modifier la réservation
                                    </a>

                                </div>

                                {% endif %}

                                {% if reservation.status.value in ['pending', 'confirmed'] %}

                                <form class="account-cancel-form" method="post" action="{{ path(
        'app_account_reservation_cancel',
        { id: reservation.id }
    ) }}" data-action="submit->confirm-modal#open" data-confirm-title="Annuler la réservation"
                                    data-confirm-message="Êtes-vous sûr de vouloir annuler cette réservation ? Cette action ne pourra pas être annulée."
                                    data-confirm-button="Annuler la réservation">

                                    <input type="hidden" name="_token" value="{{ csrf_token(
                                                        'cancel_reservation_' ~ reservation.id
                                                    ) }}">

                                    <button class="account-cancel-button" type="submit">
                                        Annuler cette réservation
                                    </button>

                                </form>

                                {% endif %}

                            </article>

                            {% endfor %}

                        </div>

                        {% endif %}

                    </section>

                </div>

            </div>

        </section>

    </main>

    {% include 'partials/_confirm_modal.html.twig' %}
    {% include 'partials/_site_footer.html.twig' %}

</div>

{% endblock %}