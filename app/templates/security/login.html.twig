{% extends 'base.html.twig' %}

{% block title %}
    Connexion | Taxi Paris Service 24
{% endblock %}

{% block body_class %}home-body{% endblock %}

{% block body %}

<div class="home-page">

    {% include 'partials/_site_header.html.twig' %}

    <main class="auth-page">

        <section class="auth-hero">

            <div class="home-container auth-hero-inner">

                <div>

                    <p class="section-kicker">
                        Espace client
                    </p>

                    <h1>
                        Se connecter
                    </h1>

                    <p class="auth-hero-text">
                        Accédez à votre espace personnel pour retrouver vos réservations,
                        vos informations et vos avantages fidélité.
                    </p>

                </div>


                <div class="auth-hero-benefits">

                    <div>
                        <strong>01</strong>
                        <span>Historique des trajets</span>
                    </div>

                    <div>
                        <strong>02</strong>
                        <span>Suivi des réservations</span>
                    </div>

                    <div>
                        <strong>03</strong>
                        <span>Avantages fidélité</span>
                    </div>

                </div>

            </div>

        </section>


        <section class="auth-content">

            <div class="home-container">

                <div class="auth-layout">

                    <div class="auth-intro">

                        <p class="auth-section-kicker">
                            Connexion
                        </p>

                        <h2>
                            Votre espace personnel
                        </h2>

                        <p>
                            Connectez-vous avec l'adresse email utilisée lors de
                            votre inscription pour accéder à votre compte.
                        </p>


                        <div class="auth-info-list">

                            <div>
                                <span>01</span>

                                <div>
                                    <strong>
                                        Vos réservations
                                    </strong>

                                    <p>
                                        Retrouvez vos trajets passés et à venir.
                                    </p>
                                </div>
                            </div>


                            <div>
                                <span>02</span>

                                <div>
                                    <strong>
                                        Vos coordonnées
                                    </strong>

                                    <p>
                                        Gérez facilement vos informations personnelles.
                                    </p>
                                </div>
                            </div>


                            <div>
                                <span>03</span>

                                <div>
                                    <strong>
                                        Votre fidélité
                                    </strong>

                                    <p>
                                        Consultez votre progression vers votre prochaine réduction.
                                    </p>
                                </div>
                            </div>

                        </div>

                    </div>


                    <div class="auth-form-card">

                        <div class="auth-form-heading">

                            <p class="auth-section-kicker">
                                Client existant
                            </p>

                            <h2>
                                Connexion
                            </h2>

                            <p>
                                Saisissez vos identifiants pour accéder à votre espace.
                            </p>

                        </div>


                        <form method="post" class="auth-form">

                            {% if error %}

                                <div
                                    class="auth-login-error"
                                    role="alert"
                                >
                                    {{ error.messageKey|trans(
                                        error.messageData,
                                        'security'
                                    ) }}
                                </div>

                            {% endif %}


                            {% if app.user %}

                                <div class="auth-already-connected">

                                    <p>
                                        Vous êtes déjà connecté avec
                                        <strong>{{ app.user.userIdentifier }}</strong>.
                                    </p>

                                    <a href="{{ path('app_account') }}">
                                        Accéder à mon compte →
                                    </a>

                                </div>

                            {% endif %}


                            <div class="auth-field">

                                <label for="username">
                                    Adresse email
                                </label>

                                <input
                                    type="email"
                                    value="{{ last_username }}"
                                    name="_username"
                                    id="username"
                                    autocomplete="email"
                                    placeholder="vous@exemple.fr"
                                    required
                                    autofocus
                                >

                            </div>


                            <div class="auth-field">

                                <label for="password">
                                    Mot de passe
                                </label>

                                <input
                                    type="password"
                                    name="_password"
                                    id="password"
                                    autocomplete="current-password"
                                    placeholder="Votre mot de passe"
                                    required
                                >

                            </div>


                            <input
                                type="hidden"
                                name="_csrf_token"
                                value="{{ csrf_token('authenticate') }}"
                            >


                            <div class="auth-login-options">

                                <label class="auth-remember">

                                    <input
                                        type="checkbox"
                                        name="_remember_me"
                                    >

                                    <span>
                                        Se souvenir de moi
                                    </span>

                                </label>

                            </div>


                            <button
                                class="auth-submit"
                                type="submit"
                            >
                                Se connecter
                            </button>

                        </form>


                        <div class="auth-switch">

                            <span>
                                Vous n'avez pas encore de compte ?
                            </span>

                            <a href="{{ path('app_register') }}">
                                Créer un compte →
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>

    {% include 'partials/_site_footer.html.twig' %}

</div>

{% endblock %}