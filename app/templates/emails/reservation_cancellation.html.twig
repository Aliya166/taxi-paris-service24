{% extends 'emails/_layout.html.twig' %}

{% block email_title %}
    Réservation annulée
{% endblock %}

{% block email_heading %}
    Réservation annulée
{% endblock %}

{% block email_subheading %}
    <div
        style="
            margin-top:10px;
            color:#aeb2b8;
            font-size:12px;
        "
    >
        Votre demande d'annulation a été enregistrée
    </div>
{% endblock %}


{% block email_content %}

    <p
        style="
            margin:0 0 18px;
            font-size:15px;
            line-height:1.7;
        "
    >
        Bonjour
        <strong>{{ reservation.firstName }}</strong>,
    </p>

    <p
        style="
            margin:0 0 24px;
            color:#5f646c;
            font-size:14px;
            line-height:1.7;
        "
    >
        Nous vous confirmons que votre réservation
        a bien été annulée.
    </p>


    <div
        style="
            margin-bottom:25px;
            padding:18px;
            border-left:3px solid #e50914;
            background:#fff1f2;
        "
    >
        <div
            style="
                color:#be123c;
                font-size:10px;
                font-weight:800;
                letter-spacing:1px;
                text-transform:uppercase;
            "
        >
            Annulée
        </div>

        <div
            style="
                margin-top:5px;
                color:#1b1d21;
                font-size:18px;
                font-weight:800;
            "
        >
            {{ reservation.reference }}
        </div>
    </div>


    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="10"
        style="
            width:100%;
            border-collapse:collapse;
        "
    >

        <tr>
            <td
                style="
                    width:36%;
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Date prévue
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.scheduledAt|date('d/m/Y à H:i') }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Départ
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.pickupAddress }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Arrivée
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.dropoffAddress }}
            </td>
        </tr>

    </table>


    <p
        style="
            margin:26px 0 0;
            color:#686d75;
            font-size:12px;
            line-height:1.7;
            text-align:center;
        "
    >
        Si vous avez besoin d'un nouveau trajet,
        vous pouvez effectuer une nouvelle réservation
        à tout moment.
    </p>

{% endblock %}


{% block email_footer_extra %}
    <br>
    Confirmation automatique d'annulation.
{% endblock %}