{% extends 'emails/_layout.html.twig' %}

{% block email_title %}
    Course terminée
{% endblock %}

{% block email_heading %}
    Merci pour votre confiance
{% endblock %}

{% block email_subheading %}
    <div
        style="
            margin-top:10px;
            color:#aeb2b8;
            font-size:12px;
        "
    >
        Votre course est terminée
    </div>
{% endblock %}


{% block email_content %}

    <p
        style="
            margin:0 0 18px;
            font-size:15px;
            line-height:1.7;
        "
    >
        Bonjour
        <strong>{{ reservation.firstName }}</strong>,
    </p>

    <p
        style="
            margin:0 0 24px;
            color:#5f646c;
            font-size:14px;
            line-height:1.7;
        "
    >
        Votre course avec Taxi Paris Service 24 est maintenant terminée.
        Merci de nous avoir fait confiance pour votre trajet.
    </p>


    <div
        style="
            margin-bottom:25px;
            padding:18px;
            border-left:3px solid #111317;
            background:#f7f7f8;
        "
    >
        <div
            style="
                color:#777c84;
                font-size:10px;
                font-weight:700;
                letter-spacing:1px;
                text-transform:uppercase;
            "
        >
            Réservation
        </div>

        <div
            style="
                margin-top:5px;
                color:#1b1d21;
                font-size:18px;
                font-weight:800;
            "
        >
            {{ reservation.reference }}
        </div>
    </div>


    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="10"
        style="
            width:100%;
            border-collapse:collapse;
        "
    >

        <tr>
            <td
                style="
                    width:36%;
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Date
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.scheduledAt|date('d/m/Y à H:i') }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Trajet
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.pickupAddress }}
                →
                {{ reservation.dropoffAddress }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Véhicule
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.vehicleType.label() }}
            </td>
        </tr>

    </table>


    <div
        style="
            margin-top:26px;
            padding:22px;
            background:#111317;
            color:#ffffff;
            text-align:center;
        "
    >
        <div
            style="
                color:#afb3ba;
                font-size:10px;
                font-weight:700;
                letter-spacing:1px;
                text-transform:uppercase;
            "
        >
            Montant de la course
        </div>

        <div
            style="
                margin-top:7px;
                font-size:30px;
                font-weight:800;
            "
        >
            {% if reservation.finalPrice is not null %}
                {{ reservation.finalPrice|number_format(2, ',', ' ') }} €
            {% else %}
                —
            {% endif %}
        </div>
    </div>


    <div
        style="
            margin-top:24px;
            padding:18px;
            border:1px solid #e4e6e9;
            text-align:center;
        "
    >
        <div
            style="
                color:#e50914;
                font-size:10px;
                font-weight:800;
                letter-spacing:1px;
                text-transform:uppercase;
            "
        >
            Fidélité
        </div>

        <p
            style="
                margin:8px 0 0;
                color:#5f646c;
                font-size:12px;
                line-height:1.7;
            "
        >
            Chaque course terminée vous rapproche
            de votre prochain avantage fidélité.
        </p>
    </div>

{% endblock %}


{% block email_footer_extra %}
    <br>
    À bientôt pour votre prochain trajet.
{% endblock %}