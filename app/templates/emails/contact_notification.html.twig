{% extends 'emails/_layout.html.twig' %}

{% block email_title %}
    Nouveau message de contact
{% endblock %}

{% block email_heading %}
    Nouveau message
{% endblock %}

{% block email_subheading %}
    <div
        style="
            margin-top:10px;
            color:#aeb2b8;
            font-size:12px;
            line-height:1.5;
        "
    >
        Un visiteur vient de contacter Taxi Paris Service 24
    </div>
{% endblock %}


{% block email_content %}

    <div
        style="
            margin-bottom:24px;
            padding:16px 18px;
            border-left:3px solid #e50914;
            background:#fff1f2;
            color:#9f1239;
            font-size:12px;
            line-height:1.6;
        "
    >
        Un nouveau message a été envoyé depuis le formulaire de contact du site.
    </div>


    <h2
        style="
            margin:0 0 14px;
            font-size:18px;
        "
    >
        Coordonnées
    </h2>


    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="10"
        style="
            width:100%;
            margin-bottom:27px;
            border-collapse:collapse;
        "
    >

        <tr>
            <td
                style="
                    width:36%;
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Nom
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                    font-weight:700;
                "
            >
                {{ contact.name }}
            </td>
        </tr>


        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Email
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                <a
                    href="mailto:{{ contact.email }}"
                    style="
                        color:#e50914;
                        text-decoration:none;
                    "
                >
                    {{ contact.email }}
                </a>
            </td>
        </tr>


        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Téléphone
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {% if contact.phone %}
                    <a
                        href="tel:{{ contact.phone }}"
                        style="
                            color:#e50914;
                            text-decoration:none;
                        "
                    >
                        {{ contact.phone }}
                    </a>
                {% else %}
                    Non renseigné
                {% endif %}
            </td>
        </tr>


        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Sujet
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ contact.subject }}
            </td>
        </tr>

    </table>


    <h2
        style="
            margin:0 0 14px;
            font-size:18px;
        "
    >
        Message
    </h2>


    <div
        style="
            padding:18px;
            background:#f7f7f8;
            color:#4f545b;
            font-size:13px;
            line-height:1.8;
            white-space:pre-line;
        "
    >
        {{ contact.message }}
    </div>

{% endblock %}


{% block email_footer_extra %}
    <br>
    Répondez directement à cet email pour contacter l'expéditeur.
{% endblock %}
