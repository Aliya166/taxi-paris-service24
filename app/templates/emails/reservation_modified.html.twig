{% extends 'emails/_layout.html.twig' %}

{% block email_title %}
    Réservation modifiée
{% endblock %}

{% block email_heading %}
    Réservation modifiée
{% endblock %}

{% block email_subheading %}
    <div
        style="
            margin-top:10px;
            color:#aeb2b8;
            font-size:12px;
            line-height:1.5;
        "
    >
        Vos modifications ont bien été enregistrées
    </div>
{% endblock %}


{% block email_content %}

    <p
        style="
            margin:0 0 18px;
            font-size:15px;
            line-height:1.7;
        "
    >
        Bonjour
        <strong>{{ reservation.firstName }}</strong>,
    </p>

    <p
        style="
            margin:0 0 24px;
            color:#5f646c;
            font-size:14px;
            line-height:1.7;
        "
    >
        Les modifications apportées à votre réservation
        ont bien été enregistrées.
    </p>


    <div
        style="
            margin-bottom:26px;
            padding:18px;
            border-left:3px solid #e50914;
            background:#f7f7f8;
        "
    >
        <div
            style="
                color:#777c84;
                font-size:10px;
                font-weight:700;
                letter-spacing:1px;
                text-transform:uppercase;
            "
        >
            Référence
        </div>

        <div
            style="
                margin-top:5px;
                color:#1b1d21;
                font-size:19px;
                font-weight:800;
            "
        >
            {{ reservation.reference }}
        </div>
    </div>


    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="10"
        style="
            width:100%;
            border-collapse:collapse;
        "
    >

        <tr>
            <td
                style="
                    width:36%;
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Statut
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                    font-weight:700;
                "
            >
                {{ reservation.status.label() }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Date
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.scheduledAt|date('d/m/Y à H:i') }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Départ
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.pickupAddress }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Arrivée
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.dropoffAddress }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Véhicule
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.vehicleType.label() }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Passagers / Bagages
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.passengers }}
                /
                {{ reservation.luggage }}
            </td>
        </tr>

    </table>


    <div
        style="
            margin-top:26px;
            padding:22px;
            background:#111317;
            color:#ffffff;
            text-align:center;
        "
    >
        <div
            style="
                color:#afb3ba;
                font-size:10px;
                font-weight:700;
                letter-spacing:1px;
                text-transform:uppercase;
            "
        >
            Nouveau prix estimé
        </div>

        <div
            style="
                margin-top:7px;
                font-size:30px;
                font-weight:800;
            "
        >
            {% if reservation.finalPrice is not null %}
                {{ reservation.finalPrice|number_format(2, ',', ' ') }} €
            {% else %}
                À confirmer
            {% endif %}
        </div>
    </div>


    <div
        style="
            margin-top:24px;
            padding:16px;
            background:#fff7ed;
            color:#8a5208;
            font-size:12px;
            line-height:1.7;
        "
    >
        Votre réservation reste en attente de confirmation.
        Vous recevrez un nouvel email lorsqu'elle sera validée.
    </div>

{% endblock %}


{% block email_footer_extra %}
    <br>
    Cet email est lié à votre réservation et n'est pas un message publicitaire.
{% endblock %}