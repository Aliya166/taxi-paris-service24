<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>Réservation modifiée</title>
</head>

<body style="
    margin:0;
    padding:0;
    background:#f3f4f6;
    font-family:Arial,Helvetica,sans-serif;
    color:#1f2937;
">

<table
    role="presentation"
    width="100%"
    cellspacing="0"
    cellpadding="0"
>
    <tr>
        <td
            align="center"
            style="padding:35px 15px;"
        >

            <table
                role="presentation"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                style="
                    max-width:620px;
                    background:#ffffff;
                    border-collapse:collapse;
                "
            >

                <tr>
                    <td
                        style="
                            height:5px;
                            background:#e50914;
                            font-size:0;
                        "
                    >
                        &nbsp;
                    </td>
                </tr>


                <tr>
                    <td
                        style="
                            padding:30px;
                            background:#111317;
                            text-align:center;
                        "
                    >

                        <div
                            style="
                                color:#e50914;
                                font-size:11px;
                                font-weight:700;
                                letter-spacing:2px;
                                text-transform:uppercase;
                            "
                        >
                            Administration
                        </div>

                        <div
                            style="
                                margin-top:8px;
                                color:#ffffff;
                                font-size:25px;
                                font-weight:800;
                            "
                        >
                            RÉSERVATION MODIFIÉE
                        </div>

                    </td>
                </tr>


                <tr>
                    <td style="padding:32px;">

                        <div
                            style="
                                margin-bottom:24px;
                                padding:16px;
                                border-left:3px solid #e50914;
                                background:#fff1f2;
                                color:#9f1239;
                                font-size:13px;
                                line-height:1.6;
                            "
                        >
                            Le client a modifié une réservation
                            depuis son espace personnel.
                        </div>


                        <div
                            style="
                                margin-bottom:25px;
                                padding:17px;
                                background:#f7f7f8;
                            "
                        >
                            <div
                                style="
                                    color:#6b7280;
                                    font-size:11px;
                                    text-transform:uppercase;
                                "
                            >
                                Référence
                            </div>

                            <div
                                style="
                                    margin-top:5px;
                                    font-size:18px;
                                    font-weight:800;
                                "
                            >
                                {{ reservation.reference }}
                            </div>
                        </div>


                        <h2
                            style="
                                margin:0 0 14px;
                                font-size:18px;
                            "
                        >
                            Client
                        </h2>

                        <table
                            role="presentation"
                            width="100%"
                            cellspacing="0"
                            cellpadding="9"
                            style="
                                margin-bottom:27px;
                                border-collapse:collapse;
                            "
                        >

                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Nom
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    {{ reservation.firstName }}
                                    {{ reservation.lastName }}
                                </td>
                            </tr>


                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Email
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    <a
                                        href="mailto:{{ reservation.email }}"
                                        style="color:#e50914;"
                                    >
                                        {{ reservation.email }}
                                    </a>
                                </td>
                            </tr>


                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Téléphone
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    <a
                                        href="tel:{{ reservation.phone }}"
                                        style="color:#e50914;"
                                    >
                                        {{ reservation.phone }}
                                    </a>
                                </td>
                            </tr>

                        </table>


                        <h2
                            style="
                                margin:0 0 14px;
                                font-size:18px;
                            "
                        >
                            Nouvelles informations
                        </h2>


                        <table
                            role="presentation"
                            width="100%"
                            cellspacing="0"
                            cellpadding="9"
                            style="border-collapse:collapse;"
                        >

                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Date
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    {{ reservation.scheduledAt|date('d/m/Y à H:i') }}
                                </td>
                            </tr>


                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Départ
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    {{ reservation.pickupAddress }}
                                </td>
                            </tr>


                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Arrivée
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    {{ reservation.dropoffAddress }}
                                </td>
                            </tr>


                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Véhicule
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    {{ reservation.vehicleType.label() }}
                                </td>
                            </tr>


                            <tr>
                                <td
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        color:#6b7280;
                                        font-size:13px;
                                    "
                                >
                                    Passagers / Bagages
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-bottom:1px solid #e5e7eb;
                                        font-size:13px;
                                    "
                                >
                                    {{ reservation.passengers }}
                                    /
                                    {{ reservation.luggage }}
                                </td>
                            </tr>


                            {% if reservation.distanceKm is not null %}

                                <tr>
                                    <td
                                        style="
                                            border-bottom:1px solid #e5e7eb;
                                            color:#6b7280;
                                            font-size:13px;
                                        "
                                    >
                                        Distance
                                    </td>

                                    <td
                                        align="right"
                                        style="
                                            border-bottom:1px solid #e5e7eb;
                                            font-size:13px;
                                        "
                                    >
                                        {{ reservation.distanceKm|number_format(2, ',', ' ') }}
                                        km
                                    </td>
                                </tr>

                            {% endif %}


                            {% if reservation.durationMinutes is not null %}

                                <tr>
                                    <td
                                        style="
                                            border-bottom:1px solid #e5e7eb;
                                            color:#6b7280;
                                            font-size:13px;
                                        "
                                    >
                                        Durée estimée
                                    </td>

                                    <td
                                        align="right"
                                        style="
                                            border-bottom:1px solid #e5e7eb;
                                            font-size:13px;
                                        "
                                    >
                                        {{ reservation.durationMinutes }}
                                        min
                                    </td>
                                </tr>

                            {% endif %}

                        </table>


                        <div
                            style="
                                margin-top:26px;
                                padding:22px;
                                background:#111317;
                                color:#ffffff;
                                text-align:center;
                            "
                        >

                            <div
                                style="
                                    color:#b9bdc4;
                                    font-size:12px;
                                    text-transform:uppercase;
                                "
                            >
                                Nouveau prix estimé
                            </div>

                            <div
                                style="
                                    margin-top:7px;
                                    font-size:30px;
                                    font-weight:800;
                                "
                            >
                                {% if reservation.finalPrice is not null %}
                                    {{ reservation.finalPrice|number_format(2, ',', ' ') }} €
                                {% else %}
                                    À confirmer
                                {% endif %}
                            </div>

                        </div>


                        <p
                            style="
                                margin:24px 0 0;
                                color:#6b7280;
                                font-size:12px;
                                line-height:1.6;
                                text-align:center;
                            "
                        >
                            La réservation reste en attente.
                            Vérifiez les nouvelles informations avant de la confirmer.
                        </p>

                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>