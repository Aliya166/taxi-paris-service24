{% extends 'emails/_layout.html.twig' %}

{% block email_title %}
    Réservation annulée
{% endblock %}

{% block email_heading %}
    Réservation annulée
{% endblock %}

{% block email_subheading %}
    <div
        style="
            margin-top:10px;
            color:#aeb2b8;
            font-size:12px;
        "
    >
        Annulation effectuée par le client
    </div>
{% endblock %}


{% block email_content %}

    <div
        style="
            margin-bottom:24px;
            padding:16px 18px;
            border-left:3px solid #e50914;
            background:#fff1f2;
            color:#9f1239;
            font-size:12px;
            line-height:1.6;
        "
    >
        Le client a annulé sa réservation depuis son espace personnel.
        Aucune confirmation supplémentaire n'est nécessaire.
    </div>


    <div
        style="
            margin-bottom:26px;
            padding:18px;
            background:#f7f7f8;
        "
    >
        <div
            style="
                color:#777c84;
                font-size:10px;
                font-weight:700;
                letter-spacing:1px;
                text-transform:uppercase;
            "
        >
            Référence
        </div>

        <div
            style="
                margin-top:5px;
                color:#1b1d21;
                font-size:19px;
                font-weight:800;
            "
        >
            {{ reservation.reference }}
        </div>
    </div>


    <h2
        style="
            margin:0 0 14px;
            font-size:18px;
        "
    >
        Client
    </h2>


    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="10"
        style="
            width:100%;
            margin-bottom:27px;
            border-collapse:collapse;
        "
    >

        <tr>
            <td
                style="
                    width:36%;
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Nom
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                    font-weight:700;
                "
            >
                {{ reservation.firstName }}
                {{ reservation.lastName }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Email
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                <a
                    href="mailto:{{ reservation.email }}"
                    style="
                        color:#e50914;
                        text-decoration:none;
                    "
                >
                    {{ reservation.email }}
                </a>
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Téléphone
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                <a
                    href="tel:{{ reservation.phone }}"
                    style="
                        color:#e50914;
                        text-decoration:none;
                    "
                >
                    {{ reservation.phone }}
                </a>
            </td>
        </tr>

    </table>


    <h2
        style="
            margin:0 0 14px;
            font-size:18px;
        "
    >
        Trajet annulé
    </h2>


    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="10"
        style="
            width:100%;
            border-collapse:collapse;
        "
    >

        <tr>
            <td
                style="
                    width:36%;
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Date prévue
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.scheduledAt|date('d/m/Y à H:i') }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Départ
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.pickupAddress }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Arrivée
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.dropoffAddress }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Véhicule
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                "
            >
                {{ reservation.vehicleType.label() }}
            </td>
        </tr>

        <tr>
            <td
                style="
                    border-bottom:1px solid #e6e8eb;
                    color:#777c84;
                    font-size:12px;
                "
            >
                Prix
            </td>

            <td
                align="right"
                style="
                    border-bottom:1px solid #e6e8eb;
                    font-size:12px;
                    font-weight:800;
                "
            >
                {% if reservation.finalPrice is not null %}
                    {{ reservation.finalPrice|number_format(2, ',', ' ') }} €
                {% else %}
                    —
                {% endif %}
            </td>
        </tr>

    </table>


    <div
        style="
            margin-top:25px;
            padding:17px;
            background:#f7f7f8;
            color:#686d75;
            font-size:12px;
            line-height:1.7;
            text-align:center;
        "
    >
        Cette réservation est désormais marquée comme annulée
        dans l'administration.
    </div>

{% endblock %}


{% block email_footer_extra %}
    <br>
    Répondez directement à cet email si vous devez contacter le client.
{% endblock %}